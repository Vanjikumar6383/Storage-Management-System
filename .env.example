# Environment variables template for Storage Lifecycle Optimizer
# NEVER commit real credentials or secrets to version control.

# Application Configuration
APP_ENV=development
APP_NAME=Storage Lifecycle Optimizer
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL - Local Development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=storage_optimizer_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storage_optimizer_dev

# Redis / Worker Configuration (Local Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage Provider Configuration (LOCAL_S3_COMPATIBLE or AWS_S3)
# Default is DEMO STORAGE (LOCAL_S3_COMPATIBLE) - zero AWS account or internet required
STORAGE_PROVIDER=LOCAL_S3_COMPATIBLE

# Demo / Local S3-compatible configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional Real AWS S3 Configuration (To enable real AWS S3: set STORAGE_PROVIDER=AWS_S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=

